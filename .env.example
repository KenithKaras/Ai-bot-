# ===================================================================
# Radox AI Full-Stack Chat Application - Environment Configuration
# ===================================================================
# Copy this file to `backend/.env` (or project root) and configure values.
# NEVER commit your actual API keys or secrets to version control.

# Radox AI Provider Configuration
# Obtain your key from your Radox AI Dashboard (https://radoxai.com)
# Format starts with `cc_` followed by 48 characters
RADOX_API_KEY=your_radox_api_key_here
RADOX_BASE_URL=https://radoxai.com/v1

# Backend Server Configuration
PORT=4000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Request Timeout (milliseconds)
REQUEST_TIMEOUT_MS=60000
